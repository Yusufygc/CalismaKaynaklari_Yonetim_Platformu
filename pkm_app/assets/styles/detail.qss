/* detail.qss */

#DetailView {
    background-color: {{surface_elevated}};
    border-left: 1px solid {{border_color}};
}

#DetailTitle {
    color: {{text_primary}};
    font-size: 16px;
    font-weight: 800;
}

#DetailUrlButton {
    color: {{accent_color}};
    font-size: 11px;
    font-weight: 600;
    text-align: left;
    border: 1px solid {{border_color}};
    border-radius: 12px;
    background-color: {{tag_badge_bg}};
    padding: 4px 10px;
}

#DetailUrlButton:hover {
    border-color: {{accent_color}};
    background-color: {{surface_hover}};
}

#DetailCloseButton {
    background: transparent;
    border: none;
    border-radius: 4px;
}

#DetailCloseButton:hover {
    background-color: {{surface_hover}};
}

#StatusCombo {
    background-color: {{bg_secondary}};
    color: {{text_primary}};
    border: 1px solid {{border_color}};
    border-radius: 8px;
    padding: 5px 9px;
}

#NotesEdit {
    background-color: {{bg_secondary}};
    color: {{text_primary}};
    border: 1px solid {{border_color}};
    border-radius: 8px;
    padding: 8px;
    font-family: "JetBrains Mono", "Cascadia Code", "Consolas";
    font-size: 12px;
}

/* --- Yeni Kaynak Formu --- */

#ResourceForm {
    background-color: {{bg_secondary}};
}

#FormHeader {
    color: {{text_primary}};
    font-size: 14px;
    font-weight: 700;
}

#FormField,
#FormCombo,
#FormTextEdit {
    background-color: {{bg_secondary}};
    color: {{text_primary}};
    border: 1px solid {{border_color}};
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 12px;
}

#FormField:focus,
#FormTextEdit:focus {
    border-color: {{focus_ring}};
}

#FormInlineAddButton {
    background-color: transparent;
    border: 1px solid {{accent_color}};
    border-radius: 7px;
}

#FormInlineAddButton:hover {
    background-color: {{nav_selected_bg}};
}

#SaveButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 {{accent_gradient_start}}, stop:1 {{accent_gradient_end}});
    color: {{on_accent}};
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
}

#SaveButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 {{accent_secondary}}, stop:1 {{accent_gradient_end}});
}

#CancelButton {
    background-color: transparent;
    color: {{text_secondary}};
    border: 1px solid {{border_color}};
    border-radius: 8px;
    padding: 6px 12px;
}

#CancelButton:hover {
    background-color: {{surface_hover}};
}

/* --- Kaynak isleme butonlari --- */

#SaveNotesButton {
    background-color: transparent;
    color: {{accent_color}};
    border: 1px solid {{accent_color}};
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 11px;
}

#SaveNotesButton:hover {
    background-color: {{nav_selected_bg}};
}

#ReadResourceButton {
    background-color: transparent;
    color: {{accent_color}};
    border: 1px solid {{accent_color}};
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}

#ReadResourceButton:hover {
    background-color: {{nav_selected_bg}};
}

#EditResourceButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 {{accent_gradient_start}}, stop:1 {{accent_gradient_end}});
    color: {{on_accent}};
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}

#EditResourceButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 {{accent_secondary}}, stop:1 {{accent_gradient_end}});
}

#DeleteResourceButton {
    background-color: transparent;
    color: {{danger_color}};
    border: 1px solid {{danger_color}};
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
}

#DeleteResourceButton:hover {
    background-color: {{danger_bg}};
}

#DeleteResourceConfirmButton {
    background-color: {{danger_hover}};
    color: {{on_accent}};
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}

/* --- Inline Banner --- */

#InlineBanner {
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
}

#InlineBanner[severity="error"] {
    background-color: {{danger_hover}};
    color: {{on_accent}};
}

#InlineBanner[severity="info"] {
    background-color: {{accent_color}};
    color: {{on_accent}};
}
