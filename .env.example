# Ornek ortam yapilandirmasi: bu dosyayi `.env` olarak kopyalayip degistirin (.env git'e girmez).
# Tum degerler istege baglidir; verilmezse core/config.py varsayilanlari kullanilir.

# development | production  (LOG_LEVEL bos ise development=DEBUG, digerleri=INFO)
APP_ENV=development

# Bos birakilirsa: %APPDATA%/PKM/pkm_app.db (bkz. core/paths.py)
# DATABASE_URL=sqlite:///C:/Users/<kullanici>/AppData/Roaming/PKM/pkm_app.db

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=

# Log dosyasi yolu (bos: %APPDATA%/PKM/app.log)
# LOG_FILE=

# light | dark
DEFAULT_THEME=light
